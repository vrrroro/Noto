# Copy to .env.local and fill in the values from the CloudFormation stack outputs
# (infrastructure/scripts/deploy.ps1 writes this file for you).
# If any of these are empty the app runs in DEMO MODE: everything works
# locally in the browser and no AWS resources are used.

VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_URL=
